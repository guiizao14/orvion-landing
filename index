  :root[data-theme="dark"] {
    --bg: #121110;
    --raised: #1B1A18;
    --ink: #F2EFE9;
    --ink-soft: #A9A196;
    --ink-faint: #6E675D;
    --accent: #E5443C;
    --line: rgba(242, 239, 233, 0.12);
    --line-soft: rgba(242, 239, 233, 0.07);
    --panel: #1B1A18;
    --panel-ink: #F2EFE9;
    --shadow: 0 1px 2px rgba(0, 0, 0, 0.4), 0 8px 24px rgba(0, 0, 0, 0.28);
