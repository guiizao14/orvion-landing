  h1 {
    font-family: 'Unbounded', 'Archivo', sans-serif;
    font-weight: 700;
    font-size: clamp(28px, 6.2vw, 40px);
    line-height: 1.14;
    letter-spacing: -0.022em;
    text-wrap: balance;
    max-width: 19ch;
    margin-bottom: 20px;
  }

  .lede {
    font-size: clamp(15.5px, 4vw, 17.5px);
    line-height: 1.58;
    color: var(--ink-soft);
    max-width: 46ch;
    margin-bottom: 28px;
  }

  .cta-block { display: flex; flex-direction: column; gap: 12px; }

  .cta-row { display: flex; flex-wrap: wrap; gap: 11px; }

  .cta-note {
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--ink-faint);
    max-width: 40ch;
  }

  /* ---------------- amostra de conversa ---------------- */

  .chat {
    background: var(--raised);
    border: 1px solid var(--line-soft);
    border-radius: 16px;
    padding: 20px 18px 18px;
    box-shadow: var(--shadow);
    max-width: 440px;
    width: 100%;
  }

  .chat-head {
    display: flex;
    align-items: center;
    gap: 11px;
    padding-bottom: 15px;
    margin-bottom: 16px;
    border-bottom: 1px solid var(--line-soft);
  }

  .mark-sm { width: 36px; height: 36px; }

  .chat-who { min-width: 0; }

  .chat-name {
    font-size: 14.5px;
    font-weight: 600;
    line-height: 1.2;
  }

  .chat-status {
    font-size: 12px;
    color: var(--ink-faint);
    line-height: 1.3;
    margin-top: 2px;
  }

  .thread { display: flex; flex-direction: column; gap: 10px; }

  .bubble {
    font-size: 14.5px;
    line-height: 1.5;
    padding: 11px 14px;
    border-radius: 14px;
    max-width: 88%;
    word-wrap: break-word;
    overflow-wrap: anywhere;
  }

  .bubble.them {
    align-self: flex-start;
    background: var(--bg);
    border: 1px solid var(--line-soft);
    color: var(--ink-soft);
    border-bottom-left-radius: 5px;
  }

  .bubble.orvi {
    align-self: flex-end;
    background: var(--ink);
    color: var(--bg);
    border-bottom-right-radius: 5px;
  }

  .chat-foot {
    margin-top: 15px;
    padding-top: 13px;
    border-top: 1px solid var(--line-soft);
    font-size: 12.5px;
    color: var(--ink-faint);
    line-height: 1.45;
  }

  /* ---------------- lista do que faz ---------------- */

  .section { padding: 64px 0; }

  h2 {
    font-family: 'Unbounded', 'Archivo', sans-serif;
    font-weight: 600;
    font-size: clamp(22px, 5.4vw, 31px);
    line-height: 1.2;
    letter-spacing: -0.018em;
    text-wrap: balance;
    max-width: 20ch;
    margin-bottom: 34px;
