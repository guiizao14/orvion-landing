  }

  /* ---------------- header ---------------- */

  .sentinel { position: absolute; top: 0; height: 1px; width: 100%; }

  header.bar {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: saturate(1.6) blur(12px);
    -webkit-backdrop-filter: saturate(1.6) blur(12px);
    border-bottom: 1px solid transparent;
    transition: border-color 240ms ease;
  }

  header.bar.stuck { border-bottom-color: var(--line-soft); }

  .bar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 74px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 13px;
    min-width: 0;
  }

  /* recorte circular justo no símbolo, no estilo foto de perfil */
  .mark {
    border-radius: 50%;
    background: #FFFFFF;
    overflow: hidden;
    flex-shrink: 0;
    display: block;
    box-shadow: 0 0 0 1px var(--line-soft);
  }

  /* A marca ocupa 59,8% x 61,1% do arquivo e fica 21px a direita e 7px acima
     do centro. O scale deixa ela em ~78% do circulo e o translate corrige
     esse desvio, para o anel nao encostar na borda. */
  .mark img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: translate(-2.14%, 0.72%) scale(1.28);
    transform-origin: 50% 50%;
    display: block;
  }

  .mark-lg { width: 54px; height: 54px; }

  .wordmark {
    font-family: 'Unbounded', 'Archivo', sans-serif;
    font-weight: 700;
    font-size: 19px;
    letter-spacing: 0.055em;
    line-height: 1;
    white-space: nowrap;
  }

  /* ---------------- buttons ---------------- */

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    white-space: nowrap;
    font-family: 'Archivo', sans-serif;
    font-weight: 600;
    font-size: 15.5px;
    letter-spacing: 0.005em;
    padding: 14px 24px;
    border-radius: 8px;
    background: var(--cta-bg);
    color: var(--cta-ink);
    border: 1px solid transparent;
    transition: background 200ms ease, transform 120ms ease;
  }

  .btn:hover { background: var(--cta-bg-hover); }
  .btn:active { transform: scale(0.985); }

  .btn svg { width: 17px; height: 17px; flex-shrink: 0; }

  .btn-sm { padding: 10px 18px; font-size: 14.5px; }

  .btn-quiet {
    background: transparent;
    color: var(--ink-soft);
    border-color: var(--line);
    font-weight: 500;
  }

  .btn-quiet:hover { background: transparent; color: var(--ink); border-color: var(--ink-faint); }

  /* precisa vir depois de .btn, senao o display do botao vence a cascata */
  .bar-cta { display: none; }

  /* ---------------- hero ---------------- */

  .hero { padding: 52px 0 64px; }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: center;
  }

  .eyebrow {
    display: inline-block;
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 20px;
