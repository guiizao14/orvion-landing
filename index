    .chat { margin-left: auto; }
    .section { padding: 80px 0; }
    .close { padding: 88px 0 96px; }
    h2 { margin-bottom: 40px; }
  }
</style>

<script>
  // Roda antes da pintura: so liga a animacao se o navegador tiver como executa-la.
  (function () {
