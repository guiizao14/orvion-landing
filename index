<script>
  (function () {
    var root = document.documentElement;
    var bar = document.getElementById('bar');
    var dock = document.getElementById('dock');
    var armed = root.classList.contains('reveal-on');

    // esconde a barra fixa enquanto o topo esta a vista
    if (root.classList.contains('dock-armed') && dock) dock.classList.add('tucked');

    function revealAll() {
      var all = document.querySelectorAll('[data-reveal]');
      for (var i = 0; i < all.length; i++) all[i].classList.add('seen');
    }

    if (!armed) return; // conteudo ja esta visivel pelo CSS

    var items = document.querySelectorAll('[data-reveal]');
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('seen');
          io.unobserve(entry.target);
        }
      });
    }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
    items.forEach(function (el) { io.observe(el); });

    // rede de seguranca: se por qualquer motivo o observer nao entregar,
    // o conteudo aparece assim mesmo em vez de ficar invisivel para sempre
    setTimeout(revealAll, 1800);

    // cabecalho e barra fixa, sem listener de scroll
    var sentinel = document.getElementById('top-sentinel');
    if (sentinel) {
      var io2 = new IntersectionObserver(function (entries) {
        var atTop = entries[0].isIntersecting;
        if (bar) bar.classList.toggle('stuck', !atTop);
        if (dock) dock.classList.toggle('tucked', atTop);
      }, { threshold: 0 });
      io2.observe(sentinel);
    }
  })();
</script>
